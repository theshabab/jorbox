{
  "name": "jorbox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:worker": "npm run build && wrangler dev",
    "db:generate-seed": "node scripts/seed.js",
    "db:migrate:local": "wrangler d1 migrations apply jorbox --local",
    "db:seed:local": "wrangler d1 execute jorbox --local --file=worker/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply jorbox --remote",
    "db:seed:remote": "wrangler d1 execute jorbox --remote --file=worker/seed.sql",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/*.test.js",
    "auth:configure": "node scripts/configure-github.js"
  },
  "dependencies": {
    "lucide-react": "^0.554.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "miniflare": "^5.20261001.0-alpha",
    "vite": "^7.2.4",
    "wrangler": "^4.147.0"
  }
}
